# Altairone Drive 연결 설정 템플릿
# 이 파일을 복사해서 .env 로 이름 변경 후 값을 채워주세요
# cp .env.example .env

# ── 고정값 (변경 불필요) ───────────────────────────────────────────────────
SERVER_URL=https://your-altairone-server.example.com
CLIENT_NAME=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── 초기 1회 수동 입력 (이후 자동 갱신) ─────────────────────────────────────
# 브라우저 쿠키에서 복사 (자세한 방법은 README.md 참조)
ACCESS_TOKEN=eyJhbGci...
REFRESH_TOKEN=ory_rt_...

# ── 다운로드 목적지 ────────────────────────────────────────────────────────
# 절대경로 예시 (Linux): DEST_DIR=/data/altairone/drive_data
# 상대경로 예시:         DEST_DIR=./drive_data
DEST_DIR=./drive_data
